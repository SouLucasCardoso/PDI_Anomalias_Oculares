# Dados e arquivos baixados
**/data/
*.zip
# Pacotes locais de recuperacao em texto; contêm escores derivados, como os NPZ.
**/backups/**/*.b64
# Copias recuperaveis locais de imagens biometricas.
*.png.b64

# Ambientes e caches
/.runtime/
**/.runtime/
**/tmp/
**/.venv/
**/.vscode/
**/__pycache__/
*.pyc

# Pesos e arquivos com caminhos locais
*.pt
*.pt.part
*.pth
*.onnx
*.safetensors
*.npy
*.sqlite3
*.sqlite3-*
*.db
